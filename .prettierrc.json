{
  "plugins": ["prettier-plugin-astro", "prettier-plugin-tailwindcss"],
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 140,
  "tabWidth": 4,
  "endOfLine": "lf",
  "overrides": [
    {
      "files": "*.astro",
      "options": {
        "parser": "astro"
      }
    },
    {
      "files": ["**/*.css", "**/*.html"],
      "options": {
        "singleQuote": false
      }
    },
    {
      "files": ["**/*.css", "**/*.js", "**/*.json", "**/*.yml", "**/*.yaml"],
      "options": {
        "tabWidth": 2
      }
    }
  ]
}

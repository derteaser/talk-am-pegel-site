---
/**
 * Ported from site/templates/components/layout.blade.php — the site's only layout.
 *
 * Changes from the Blade version:
 *  - `icon.svg` → `favicon.svg`. The Blade original linked a file that does not
 *    exist in public/, so every page shipped a 404ing <link rel="icon">.
 *  - The stylesheet is imported here rather than pulled in by site.js, so it is
 *    emitted as a real <link rel="stylesheet">.
 *  - `$additionalStylesheets` / `$additionalScripts` are dropped: both props existed
 *    on the Blade component but no template ever passed them.
 */
import type { ImageMetadata } from 'astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Seo, { type SeoProps } from '../components/Seo.astro';
import { Font } from 'astro:assets';

import '../styles/site.css';

const FATHOM_SITE_ID = 'ZUNMTQNH';

interface Props extends SeoProps {
    /** Hero title. Kirby used `herotitle` when set, else the page title. */
    heroTitle?: string;
    heroSubtitle?: string | null;
    heroImage?: ImageMetadata;
}

const { heroTitle, heroSubtitle, heroImage, ...seo } = Astro.props;
---

<!doctype html>
<html lang="de">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="theme-color" content="#3b5883" />
        <link rel="icon" href="/favicon.ico" sizes="48x48" type="image/x-icon" />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/site.webmanifest" />
        {/*
          No `preload`: <Font> preloads every face of the family, and preloading all
          six weights (144 kB) would compete with the hero image, which is the actual
          LCP element. The generated size-adjust/ascent-override fallback metrics
          already prevent the layout shift that preloading would be buying.
        */}
        <Font cssVariable="--font-roboto" />
        <Seo {...seo} />
    </head>

    <body>
        <Header title={heroTitle ?? seo.title} subtitle={heroSubtitle} heroImage={heroImage} />
        <slot />
        <Footer />
        <script>
            import '../scripts/site.ts';
        </script>
        <script
            src="https://cdn.usefathom.com/script.js"
            data-site={FATHOM_SITE_ID}
            defer
            is:inline></script>
    </body>
</html>

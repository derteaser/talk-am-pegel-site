---
/**
 * Person card, ported from site/templates/components/person.blade.php and its
 * backing class app/View/Components/Person.php (which was pure prop plumbing).
 *
 * `animate` opts into the staggered .aos reveal used on talk detail pages, where the
 * caller increments animationDelay by 100ms per card.
 */
import { Icon } from 'astro-icon/components';
import Thumbnail from './Thumbnail.astro';
import { initials } from '../lib/content';
import type { Person } from '../lib/content';

interface Props {
    person: Person;
    animate?: boolean;
    animationDelay?: number;
}

const { person, animate = false, animationDelay = 0 } = Astro.props;
const { title, subHeading, website, linkedin, xing, mainImage } = person.data;

const socials = [
    { href: website, icon: 'ri:global-line', label: `Website von ${title}` },
    { href: linkedin, icon: 'ri:linkedin-box-fill', label: `${title} bei LinkedIn` },
    { href: xing, icon: 'ri:xing-fill', label: `${title} bei Xing` },
].filter((s) => s.href);
---

<article
    class:list={['p-4 w-full lg:w-1/5 md:w-1/3 sm:w-1/2 relative', animate && 'aos aos-fade-up']}
    x-data={animate ? '{ visible: false }' : undefined}
    x-intersect.once={animate ? `setTimeout(function() { visible = true }, ${animationDelay})` : undefined}
    :class={animate ? "visible && 'visible'" : undefined}
>
    <div class="h-full flex flex-col items-center text-center pb-2">
        {
            mainImage ? (
                <figure class="avatar w-full">
                    <div class="size-full rounded-full">
                        <Thumbnail image={mainImage} preset="square" class="size-full" alt="" />
                    </div>
                </figure>
            ) : (
                <figure class="avatar avatar-placeholder w-full">
                    <div class="bg-neutral text-neutral-content size-full rounded-full">
                        <span class="text-9xl uppercase" aria-hidden="true">
                            {initials(title)}
                        </span>
                    </div>
                </figure>
            )
        }

        <div class="w-full mt-4">
            <h2 class="font-medium text-lg text-base-content/90">{title}</h2>
            <p class="mb-4 text-base-content/60">{subHeading}</p>
        </div>
        <div class="w-full absolute bottom-0">
            <span class="inline-flex">
                {
                    socials.map((social, i) => (
                        <a
                            class:list={[
                                i > 0 && 'ml-2',
                                'text-base-content/50 hover:text-base-content/70 tooltip',
                            ]}
                            href={social.href}
                        >
                            <Icon name={social.icon} class="size-5 tooltip-toggle" />
                            <span
                                class="tooltip-content tooltip-shown:opacity-100 tooltip-shown:visible"
                                role="tooltip"
                            >
                                <span class="tooltip-body">{social.label}</span>
                            </span>
                        </a>
                    ))
                }
            </span>
        </div>
    </div>
</article>

---
/**
 * Image block, ported from site/snippets/blocks/image.blade.php.
 * Used from MDX bodies, where the importer emits the image as a real import so it
 * arrives as optimizable ImageMetadata rather than a path string.
 *
 * The Blade version also rendered a `Foto: {credits}` aside from the file's `credits`
 * field. That is dropped: no image sidecar in the content has ever carried `credits`,
 * `alt` or `description`, so the branch was dead. Per-image alt and caption live in
 * the block content, which is what this component receives.
 *
 * It also double-escaped alt (`$alt->esc()` inside `{{ }}`); Astro escapes once.
 */
import type { ImageMetadata } from 'astro';
import Thumbnail, { type ThumbnailPreset } from '../Thumbnail.astro';

interface Props {
    src: ImageMetadata;
    alt?: string;
    caption?: string;
    link?: string;
    /** '16/9' | '3/2' | '1/1' | '' — empty means the image's own ratio. */
    ratio?: string;
    crop?: boolean;
    /** Constrains the figure to a breakpoint width. Every block in the content is 'md'. */
    width?: string;
}

const { src, alt = '', caption = '', link = '', ratio = '', crop = false, width = 'md' } = Astro.props;

// A fixed ratio letterboxes the image (object-contain) rather than cropping it.
const ASPECT_CLASS: Record<string, string> = {
    '16/9': 'aspect-video object-contain',
    '3/2': 'aspect-3/2 object-contain',
    '1/1': 'aspect-square object-contain',
};

// Only a cropped block picks a cropping srcset preset; otherwise the full image is
// served and CSS letterboxes it.
const CROP_PRESET: Record<string, ThumbnailPreset> = {
    '16/9': 'wide',
    '3/2': 'landscape',
    '1/1': 'square',
};

const WIDTH_CLASS: Record<string, string> = {
    sm: 'max-w-(--breakpoint-sm)!',
    md: 'max-w-(--breakpoint-md)!',
    lg: 'max-w-(--breakpoint-lg)!',
    xl: 'max-w-(--breakpoint-xl)!',
};

const aspectClass = ASPECT_CLASS[ratio];
const preset: ThumbnailPreset = (crop && CROP_PRESET[ratio]) || 'default';
const widthClass = WIDTH_CLASS[width];
---

<figure class={widthClass}>
    {
        link ? (
            <a href={link}>
                <Thumbnail image={src} preset={preset} alt={alt} class={aspectClass} />
            </a>
        ) : (
            <Thumbnail image={src} preset={preset} alt={alt} class={aspectClass} />
        )
    }
    {caption && <figcaption>{caption}</figcaption>}
</figure>

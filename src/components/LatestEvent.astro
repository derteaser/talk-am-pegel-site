---
/**
 * Home page teaser for the newest talk, ported from
 * site/templates/components/latest-event.blade.php.
 *
 * Note this template extracted its excerpt CORRECTLY (filterBy 'text'), unlike the
 * meta-tag config, which filtered a non-existent 'paragraph' type — which is why the
 * home page was the only page on the Kirby site with a description.
 */
import Thumbnail from './Thumbnail.astro';
import { excerpt, decodeEntities, widont } from '../lib/content';
import { firstTextBlockHtml } from '../lib/talkBody';
import { formatDate } from '../lib/dates';
import type { Talk } from '../lib/content';

interface Props {
    talk: Talk;
}

const { talk } = Astro.props;
const description = decodeEntities(excerpt(firstTextBlockHtml(talk.body ?? ''), 400));
const href = `/talks/${talk.id}`;
---

<section class="my-24 flex flex-col space-y-16">
    <article class="container mx-auto grid grid-cols-1 gap-6 px-5 lg:grid-cols-3 xl:grid-cols-5">
        {
            /* No .aos here: this image is a view-transition target, and a reveal would hand
            the morph a transparent element on the way back from the talk page. The text
            column beside it still fades up. */
        }
        <div class="lg:order-last lg:row-span-2 xl:col-span-2" transition:name={`talk-${talk.id}`}>
            <Thumbnail image={talk.data.mainImage} preset="wide" class="w-full rounded-sm object-cover object-center" alt="" />
        </div>
        <div
            class="aos flex flex-col items-start space-y-8 lg:col-span-2 xl:col-span-3"
            x-data="{ visible: false }"
            x-intersect="setTimeout(function() { visible = true }, 200)"
            :class="visible && 'visible'"
        >
            <h1 class="text-base-content text-3xl font-semibold sm:text-4xl">
                <a href={href} class="link link-hover decoration-accent" set:html={widont(talk.data.title)} />
            </h1>
            <p class="text-base-content/60 text-sm">
                {talk.data.textline} am {formatDate(talk.data.date)}
            </p>
            <p class="text-base-content max-w-xl leading-relaxed">{description}</p>
            <a href={href} class="btn btn-accent">Mehr erfahren</a>
        </div>
    </article>

    <div class="divider divider-vertical"></div>

    <aside class="container mx-auto text-center">
        <a href="/talks" class="btn btn-primary btn-outline">Frühere Talks</a>
    </aside>
</section>

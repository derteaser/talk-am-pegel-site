---
/**
 * Responsive image, ported from site/templates/components/thumbnail.blade.php.
 *
 * Emits the same markup shape as the Kirby version — one WebP <source> plus a
 * same-format fallback <img> carrying its own srcset — so the parity diff stays
 * readable. AVIF is left out because it was commented out in the Blade original.
 *
 * The `preset` prop replaces Kirby's named srcsets from site/config/thumbs.php.
 * Only four of that file's 18 srcsets were ever actually requested by a template
 * (default, wide, landscape, square); `portrait` and `logo` are not ported.
 *
 * Two bugs from the Blade version are fixed here:
 *  - it emitted height="{{ $width }}", stamping a square intrinsic box on every
 *    image, which mis-hints aspect ratio and causes layout shift;
 *  - it called $image->resize(1800) twice just to read dimensions.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/** Width ladder, matching thumbs.php's 300/600/900/1200/1800. */
const WIDTHS = [300, 600, 900, 1200, 1800] as const;

/**
 * Aspect ratios from thumbs.php. Kirby cropped centre when `crop: true`; sharp
 * does the same given both dimensions plus fit/position, so the derived heights
 * match Kirby's exactly (wide → 169/338/506/675/1013, landscape → 200/400/600/…).
 */
const ASPECT = {
    default: null,
    wide: 16 / 9,
    landscape: 3 / 2,
    square: 1,
} as const;

export type ThumbnailPreset = keyof typeof ASPECT;

interface Props {
    image: ImageMetadata;
    preset?: ThumbnailPreset;
    alt?: string;
    sizes?: string;
    lazy?: boolean;
    class?: string;
}

const {
    image,
    preset = 'default',
    alt = '',
    sizes = '(min-width: 600px) 50vw, 100vw',
    lazy = true,
    class: className,
    ...rest
} = Astro.props;

const aspect = ASPECT[preset];

// Astro never upscales, so asking for a width above the source yields the source
// width and ladder entries would collide on the same file. Cap at the original, then
// add the native width so a source that falls between rungs is still served at full
// resolution (src/assets/pegelbar.jpg is 960px: the ladder alone would top out at
// 900 and quietly lose detail).
//
// The Kirby version instead emitted "1200w"/"1800w" descriptors pointing at that
// same 960px file — a lie in the current markup that disappears here.
const widths: number[] = WIDTHS.filter((w) => w <= image.width);
if (widths.at(-1) !== image.width) widths.push(image.width);

const dimensions = (w: number) =>
    aspect ? { width: w, height: Math.round(w / aspect) } : { width: w };

const variants = (format: 'webp' | 'jpeg' | 'png') =>
    Promise.all(
        widths.map((w) =>
            getImage({
                src: image,
                ...dimensions(w),
                fit: 'cover',
                position: 'center',
                format,
                quality: 85,
            }),
        ),
    );

// Keep PNG sources as PNG so flat-colour graphics don't get JPEG ringing.
const fallbackFormat = image.format === 'png' ? 'png' : 'jpeg';
const [webp, fallback] = await Promise.all([variants('webp'), variants(fallbackFormat)]);

const srcset = (list: Awaited<ReturnType<typeof variants>>) =>
    list.map((i) => `${i.src} ${i.attributes.width ?? i.options.width}w`).join(', ');

// Kirby used resize(600) for the plain src; keep the nearest equivalent as the
// no-srcset fallback, and take intrinsic dimensions from the largest variant.
const defaultSrc = fallback.find((i) => Number(i.options.width) >= 600) ?? fallback.at(-1)!;
const largest = fallback.at(-1)!;
const width = Number(largest.options.width);
const height = aspect
    ? Math.round(width / aspect)
    : Math.round((width * image.height) / image.width);
---

<picture>
    <source srcset={srcset(webp)} sizes={sizes} type="image/webp" />
    <img
        src={defaultSrc.src}
        srcset={srcset(fallback)}
        width={width}
        height={height}
        alt={alt}
        sizes={sizes}
        loading={lazy ? 'lazy' : undefined}
        class={className}
        {...rest}
    />
</picture>

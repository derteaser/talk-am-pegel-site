---
/**
 * Talk detail page, ported from site/templates/event.blade.php — the largest template.
 *
 * Structure: body (with an Eventbrite signup card alongside it for upcoming talks,
 * full-width for past ones), three fact cards with staggered reveals, the attendant
 * cards, then prev/next navigation.
 *
 * `past()` is now a BUILD-TIME decision where Kirby evaluated it per request. Every
 * talk is currently in the past, so the signup branch is unreachable today; once a
 * future talk is published the page needs a rebuild to switch over, which the daily
 * scheduled build covers.
 */
import { Icon } from 'astro-icon/components';
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Person from '../../components/Person.astro';
import { talks, persons, neighbours, isPast, excerpt, decodeEntities } from '../../lib/content';
import { allTextBlocksHtml } from '../../lib/talkBody';
import { formatDate, formatTime } from '../../lib/dates';
import { eventSchema } from '../../lib/jsonld';

export async function getStaticPaths() {
    const all = await talks();
    const everyone = await persons();
    return Promise.all(
        all.map(async (talk) => ({
            params: { slug: talk.id },
            props: {
                talk,
                attendants: talk.data.attendants
                    .map((ref) => everyone.find((p) => p.id === ref.id))
                    .filter((p): p is NonNullable<typeof p> => Boolean(p)),
                ...(await neighbours(talk.id)),
            },
        })),
    );
}

const { talk, attendants, prev, next } = Astro.props;
const { Content } = await render(talk);
const upcoming = !isPast(talk);

// Kirby's EventPage::excerpt() ran Blocks::excerpt(180) over all text blocks; it is
// used only as the Event schema's description.
const description = decodeEntities(excerpt(allTextBlocksHtml(talk.body ?? ''), 180));

const canonical = new URL(`/talks/${talk.id}`, Astro.site).href;
const og = await getImage({
    src: talk.data.mainImage,
    width: 1200,
    height: 630,
    fit: 'cover',
    position: 'center',
    format: 'jpeg',
    quality: 85,
});
const ogUrl = new URL(og.src, Astro.site).href;

const jsonLd = eventSchema({
    talk,
    description,
    pageUrl: canonical,
    imageUrl: ogUrl,
    performers: attendants.map((person) => ({
        name: person.data.title,
        jobTitle: person.data.subHeading,
        url: person.data.website || null,
        image: person.data.mainImage ? new URL(person.data.mainImage.src, Astro.site).href : null,
    })),
});
---

<Layout
    title={talk.data.title}
    description={description}
    mainImage={talk.data.mainImage}
    heroImage={talk.data.mainImage}
    heroSubtitle={talk.data.textline}
    jsonLd={jsonLd}
>
    <section class="container mx-auto flex flex-col px-5 pt-6 pb-12">
        <div class="mx-auto lg:w-4/6">
            {
                upcoming ? (
                    <div class="mt-10 flex flex-col sm:flex-row">
                        <div class="border-base-200 mb-4 border-b pb-4 sm:mb-0 sm:w-2/3 sm:border-r sm:border-b-0 sm:py-8 sm:pr-8">
                            <div class="blocks mb-4">
                                <Content />
                            </div>
                        </div>
                        <aside class="text-center sm:w-1/3 sm:py-12 sm:pl-8">
                            <div class="card">
                                <div class="card-header">
                                    <div class="text-base-content/50 bg-base-300 inline-flex size-22 items-center justify-center rounded-full">
                                        <Icon name="ri:ticket-2-line" class="size-16" />
                                    </div>
                                    <h2 class="card-title text-base-content/90 mt-4 text-lg font-medium">Anmeldung</h2>
                                    <div class="bg-primary mx-auto mt-2 mb-4 h-1 w-12 rounded-sm" />
                                </div>
                                <div class="card-body">
                                    <p class="text-base-content/80 text-base">
                                        Für die Teilnahme an unserer Veranstaltung ist eine Anmeldung zwingend erforderlich. Bitte bestellen
                                        Sie nachfolgend Ihr <strong>kostenloses</strong> Ticket über unseren Partner Eventbrite!
                                    </p>
                                </div>
                                <div class="card-footer">
                                    {/* Fathom goal conversion, carried over from the Blade template. */}
                                    <a
                                        class="btn btn-accent"
                                        href={talk.data.eventbriteUrl}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        onclick="fathom.trackGoal('DZC4R54V', 0);"
                                    >
                                        Ticket sichern
                                    </a>
                                </div>
                            </div>
                        </aside>
                    </div>
                ) : (
                    <div class="blocks mx-auto mt-10 mb-4">
                        <Content />
                    </div>
                )
            }
        </div>
    </section>

    <section class="container mx-auto flex flex-wrap px-5 py-12">
        <dl
            class="aos aos-zoom-in w-full p-4 md:w-1/2 lg:w-1/3"
            x-data="{ visible: false }"
            x-intersect.once="setTimeout(function() { visible = true }, 100)"
            :class="visible && 'visible'"
        >
            <div class="card bg-base-300 h-full">
                <dt class="sr-only">Datum</dt>
                <div class="card-body flex-row items-center space-x-3">
                    <Icon name="ri:calendar-event-fill" class="bg-primary size-10 rounded-full p-2 text-white" />
                    <dd class="text-base-content/90 text-lg font-medium">
                        {formatDate(talk.data.date)}
                    </dd>
                </div>
            </div>
        </dl>
        <dl
            class="aos aos-zoom-in w-full p-4 md:w-1/2 lg:w-1/3"
            x-data="{ visible: false }"
            x-intersect.once="setTimeout(function() { visible = true }, 300)"
            :class="visible && 'visible'"
        >
            <div class="card bg-base-300 h-full">
                <dt class="sr-only">Uhrzeit</dt>
                <div class="card-body flex-row items-center space-x-3">
                    <Icon name="ri:time-fill" class="bg-primary size-10 rounded-full p-2 text-white" />
                    <dd class="text-base-content/90 text-lg font-medium">
                        {formatTime(talk.data.date)} Uhr
                    </dd>
                </div>
            </div>
        </dl>
        <dl
            class="aos aos-zoom-in w-full p-4 lg:w-1/3"
            x-data="{ visible: false }"
            x-intersect.once="setTimeout(function() { visible = true }, 500)"
            :class="visible && 'visible'"
        >
            <div class="card bg-base-300 h-full">
                <dt class="sr-only">Ort</dt>
                <div class="card-body flex-row items-center space-x-3">
                    <Icon
                        name={talk.data.isVirtual ? 'ri:live-fill' : 'ri:map-pin-2-fill'}
                        class="bg-primary size-10 rounded-full p-2 text-white"
                    />
                    <dd class="text-base-content/90 text-lg font-medium">
                        {talk.data.locationName}
                    </dd>
                </div>
            </div>
        </dl>
    </section>

    <section class="sm: container mx-auto flex flex-wrap justify-center px-12 pt-12 pb-24 md:px-5">
        {attendants.map((person, i) => <Person person={person} animate animationDelay={100 + i * 100} />)}
    </section>

    <nav class="bg-base-300 px-3 py-4 md:px-8">
        <div class="divide-primary/60 grid items-center lg:grid-cols-2 lg:divide-x">
            {
                prev ? (
                    <div class="p-2">
                        <a href={`/talks/${prev.id}`} rel="prev" class="btn btn-neutral/80 btn-text btn-xl text-left">
                            <Icon name="ri:arrow-left-s-line" class="size-12 shrink-0" />
                            <div>
                                <span class="text-neutral/50 block text-sm font-medium uppercase">{prev.data.textline}</span>
                                <span class="sr-only">:</span>
                                <span>{prev.data.title}</span>
                            </div>
                        </a>
                    </div>
                ) : (
                    <div />
                )
            }
            {
                next && (
                    <div class="p-2 text-right">
                        <a href={`/talks/${next.id}`} rel="next" class="btn btn-neutral/80 btn-text btn-xl text-right">
                            <div>
                                <span class="text-neutral/50 block text-sm font-medium uppercase">{next.data.textline}</span>
                                <span class="sr-only">:</span>
                                <span>{next.data.title}</span>
                            </div>
                            <Icon name="ri:arrow-right-s-line" class="size-12 shrink-0" />
                        </a>
                    </div>
                )
            }
        </div>
    </nav>
</Layout>
